# ============================================
# 9router + CDIO 3 Configuration
# ============================================
# This file contains the recommended configuration for using 9router with CDIO 3
# Copy this to .env and update with your actual values
# ============================================

# --- AI CONFIGURATION (via 9router) ---
# 9router will automatically route to Qwen API
# Get your API key from: http://localhost:20128/dashboard
NINE_ROUTER_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=copy_from_9router_dashboard

# Legacy compatibility (if your code uses these)
DASHSCOPE_API_KEY=copy_from_9router_dashboard
QWEN_ENDPOINT=http://localhost:20128/v1
QWEN_MODEL_NAME=qw/qwen3-coder-plus

# --- DATABASE / STORAGE PATHS ---
DATA_DIR=./data
JOBS_DIR=./data/jobs

# --- SERVER CONFIGURATION ---
PORT=8000
HOST=0.0.0.0

# --- FEATURE FLAGS ---
ENABLE_VISUAL_PROCESSING=true
ENABLE_MAP_REDUCE=true

# ============================================
# NOTES:
# ============================================
# 1. Start 9router first: 
#    cd "C:\Users\leduc\OneDrive\Desktop\9router\9router"
#    npm run dev
#
# 2. Get API Key from 9router Dashboard:
#    http://localhost:20128/dashboard
#
# 3. Recommended Qwen Combo for CDIO 3:
#    Name: cdio3-qwen-stack
#    Models:
#      1. qw/qwen3-coder-plus (Primary - FREE)
#      2. if/qwen3-coder-plus (Backup - FREE)
#      3. glm/glm-4.7 (Cheap backup - $0.6/1M)
#
# 4. Benefits:
#    ✅ 100% FREE Qwen usage
#    ✅ Unlimited requests
#    ✅ Auto fallback if errors occur
#    ✅ Real-time monitoring in dashboard
# ============================================
